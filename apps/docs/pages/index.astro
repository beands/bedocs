---
import PageLayout from "@beands/bedocs/components/layout/PageLayout.astro";
import data from "blume:data";
import { getBlumeCollection } from "@beands/bedocs/runtime";

export const prerender = false;

const { config } = data;
const adminUrl = import.meta.env.PUBLIC_BEDOCS_ADMIN_URL ?? "/admin";

const projectRoutes = getBlumeCollection(data, { prefix: "/projects" });

const projects = projectRoutes
  .filter((route) => route.path.split("/").length === 3)
  .map((route) => ({
    title: route.title,
    path: route.path,
    description: "",
  }));
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{ title: config.title, description: config.description }}
>
  <section class="mx-auto max-w-5xl px-6 py-20">
    <div style="text-align: center; margin-bottom: 48px;">
      <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 12px;">
        {config.title}
      </h1>
      <p style="font-size: 1.125rem; color: var(--gray-500); max-width: 600px; margin: 0 auto 24px;">
        {config.description}
      </p>
      <a href={adminUrl} style="display: inline-block; padding: 10px 24px; background: #14b8a6; color: white; border-radius: 8px; text-decoration: none; font-size: 14px; font-weight: 500;">
        + Создать проект документации
      </a>
    </div>

    {projects.length > 0 ? (
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px;">
        {projects.map((project) => (
          <a
            href={project.path}
            style={{
              display: "block",
              padding: "24px",
              border: "1px solid var(--gray-200)",
              borderRadius: "12px",
              textDecoration: "none",
              color: "inherit",
              transition: "all 0.2s",
            }}
          >
            <h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 8px;">
              {project.title}
            </h2>
            <p style="font-size: 0.875rem; color: var(--gray-500); margin: 0;">
              {project.description}
            </p>
            <span style="display: inline-block; margin-top: 12px; font-size: 0.875rem; color: #14b8a6;">
              Открыть документацию →
            </span>
          </a>
        ))}
      </div>
    ) : (
      <div style="text-align: center; padding: 60px 20px; color: var(--gray-500);">
        <h2 style="font-size: 1.25rem; margin-bottom: 8px;">Проектов пока нет</h2>
        <p style="margin-bottom: 16px;">Создайте первый проект документации через панель управления</p>
        <a href={adminUrl} style="color: #14b8a6; font-size: 14px;">
          Открыть панель управления →
        </a>
      </div>
    )}
  </section>
</PageLayout>
