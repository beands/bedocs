# Admin panel configuration
PORT=3001

# Path to BeDocs docs root (relative to admin/ directory)
DOCS_ROOT=../apps/docs

# crea-ai API base URL (OpenAI-compatible)
CREA_AI_BASE=https://crea-ai.ru/v1

# Default AI model for documentation generation
# Available: gemini-2-5-flash, gemini-3-6-flash, gemini-2-5-pro
DEFAULT_MODEL=gemini-2-5-flash
